import java.util.Scanner;

public class Employee {
    // Instance variable stored in Heap Memory
    int salary;

    public void display() {
        Scanner sc = new Scanner(System.in);
        
        System.out.print("Enter bonus: ");
        // Local variable stored in Stack Memory
        int bonus = sc.nextInt();

        System.out.println("\nInside display() Method:");
        System.out.println("Salary (Instance Variable): " + salary);
        System.out.println("Bonus (Local Variable): " + bonus);

        // Local Inner Class definition
        class Report {
            public void show() {
                // Accessing outer class instance variable salary
                System.out.println("Report: Employee salary is " + salary);
            }
        }

        // Creating Report object inside display() method
        Report r = new Report();
        System.out.println("\nReport Object Created");
        System.out.println("Report Identity Hash Code: " + System.identityHashCode(r));
        
        // Executing show() method in its own stack frame
        r.show();
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter salary: ");
        
        // Creating Employee object in Heap Memory
        Employee emp = new Employee();
        emp.salary = sc.nextInt();

        System.out.println("Employee Object Created");
        System.out.println("Employee Identity Hash Code: " + System.identityHashCode(emp));
        System.out.println();

        // Calling display method
        emp.display();
    }
}
